GRID_FORGE_ENV=development
GRID_FORGE_BIND_ADDR=0.0.0.0:8080
GRID_FORGE_DATABASE_URL=postgres://grid_forge:grid_forge@localhost:5432/grid_forge
GRID_FORGE_JWT_SECRET=replace-with-a-strong-secret
GRID_FORGE_DEMO_MODE=true
GRID_FORGE_REQUIRE_CITATIONS=true
GRID_FORGE_OBJECT_STORE_ENDPOINT=http://localhost:9000
GRID_FORGE_OBJECT_STORE_BUCKET=grid-forge-documents
GRID_FORGE_OBJECT_STORE_ACCESS_KEY=minioadmin
GRID_FORGE_OBJECT_STORE_SECRET_KEY=minioadmin
GRID_FORGE_RETENTION_DAYS=365
RUST_LOG=info,grid_forge_api=debug,grid_forge_worker=debug
